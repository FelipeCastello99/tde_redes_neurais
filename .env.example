# UID/GID do host (evita CSV root-owned no bind mount)
HOST_UID=1000
HOST_GID=1000

# PostgreSQL
POSTGRES_USER=tde
POSTGRES_PASSWORD=tde
POSTGRES_DB=tde
DB_PORT=5432

# Portas publicadas no host
API_PORT=8000
WEB_PORT=3000

# URL usada pelo servidor Next.js dentro da rede do Compose.
# Mantenha http://api:8000; não use localhost aqui.
API_INTERNAL_URL=http://api:8000
