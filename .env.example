# UID/GID do processo que executa o Compose (evita PermissionError no bind mount).
# `make env` preenche automaticamente com `id -u`/`id -g`.
# Em VPS rodando como root, o valor correto é 0:0.
HOST_UID=
HOST_GID=

# PostgreSQL
POSTGRES_USER=tde
POSTGRES_PASSWORD=tde
POSTGRES_DB=tde
DB_PORT=5432

# Portas publicadas no host
API_PORT=8000
WEB_PORT=3000

# URL usada pelo servidor Next.js dentro da rede do Compose.
# Mantenha http://api:8000; não use localhost aqui.
API_INTERNAL_URL=http://api:8000
